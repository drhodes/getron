#!/bin/sh
set -eu

# getron - Tetron Installation and Version Manager CLI
# Implemented purely in POSIX /bin/sh

VERSION="1.0.0"
GITHUB_REPO="drhodes/getron"
TETRON_GITHUB_REPO="ErikAllanKincaid/tetron"


log_err() {
    printf '%s\n' "Error: $1" >&2
}

log_info() {
    printf '%s\n' "$1"
}

init_storage_layout() {
    if [ -n "${GETRON_ROOT:-}" ]; then
        ROOT_DIR="$GETRON_ROOT"
    elif [ "$(id -u)" -eq 0 ]; then
        ROOT_DIR="/usr/local/lib/tetron"
    else
        ROOT_DIR="$HOME/.local/share/tetron"
    fi

    if [ -n "${GETRON_BIN_DIR:-}" ]; then
        BIN_DIR="$GETRON_BIN_DIR"
    elif [ "$(id -u)" -eq 0 ]; then
        BIN_DIR="/usr/local/bin"
    else
        BIN_DIR="$HOME/.local/bin"
    fi

    VERSIONS_DIR="$ROOT_DIR/versions"
    STAGING_DIR="$ROOT_DIR/staging"
    ACTIVE_LINK="$ROOT_DIR/active"
    ROLLBACK_LINK="$ROOT_DIR/rollback"

    mkdir -p "$VERSIONS_DIR" "$STAGING_DIR" "$BIN_DIR"
}


show_help() {
    cat <<'EOF'
Getron: Tetron Installation and Version Management

Usage: getron <command> [arguments]

Commands:
  install [version]   Install Tetron (latest or specified version)
  update [--check]    Check for and install Tetron updates
  versions            List installed Tetron versions
  use <version>       Switch active Tetron version
  rollback            Roll back to previous known-good version
  doctor              Inspect and diagnose installation health
  repair              Perform targeted repairs on damaged installation
  gc                  Remove unused versions and cleanup cache
  uninstall <version> Remove a specific installed version
  version             Display Getron CLI version
  help, --help        Show this help message

GitHub Repository:
  https://github.com/drhodes/getron
EOF
}

discover_platform() {
    OS="$(uname -s)"
    ARCH="$(uname -m)"
    INIT_SYS="unknown"

    if [ "$OS" = "Linux" ]; then
        if [ -d "/run/systemd/system" ]; then
            INIT_SYS="systemd"
        elif command -v openrc >/dev/null 2>&1; then
            INIT_SYS="openrc"
        fi
    elif [ "$OS" = "Darwin" ]; then
        INIT_SYS="launchd"
    fi
}

atomic_symlink_switch() {
    target="$1"
    link="$2"
    tmp_link="${link}.tmp.$$"
    rm -f "$tmp_link"
    ln -s "$target" "$tmp_link"
    mv -fT "$tmp_link" "$link" 2>/dev/null || (rm -f "$link" && mv "$tmp_link" "$link")
}

verify_daemon_health() {
    ver="$1"
    if [ "${GETRON_MOCK_HEALTH_FAIL:-0}" = "1" ]; then
        log_err "Daemon health check failed for version '$ver'"
        return 1
    fi
    log_info "Daemon health check passed for version '$ver'"
    return 0
}

write_manifest() {
    target_dir="$1"
    ver="$2"
    timestamp="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date)"
    cat <<EOF > "$target_dir/manifest.toml"
version = "$ver"
target = "${OS:-Linux}-${ARCH:-x86_64}"
installed_at = "$timestamp"
protocol_version = 1
EOF
}

resolve_latest_release_tag() {
    log_info "Querying latest release from GitHub API (https://api.github.com/repos/$TETRON_GITHUB_REPO/releases/latest)..." >&2
    latest_tag=""
    if command -v curl >/dev/null 2>&1; then
        latest_tag="$(curl -s https://api.github.com/repos/$TETRON_GITHUB_REPO/releases/latest | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)"
    fi
    if [ -z "$latest_tag" ]; then
        latest_tag="v0.9.3"
    fi
    log_info "Resolved latest release tag: $latest_tag" >&2
    printf '%s' "$latest_tag"
}


fetch_and_stage_version() {
    ver="$1"
    if [ "$ver" = "latest" ] || [ "$ver" = "default" ]; then
        ver="$(resolve_latest_release_tag)"
    fi

    stage_target="$STAGING_DIR/$ver"
    rm -rf "$stage_target"
    mkdir -p "$stage_target"

    if [ "${GETRON_MOCK_DOWNLOAD:-0}" = "1" ]; then
        log_info "Staging mock Tetron binary into $stage_target..."
        cat <<'EOF' > "$stage_target/tetron"
#!/bin/sh
echo "Tetron daemon $VERSION"
EOF
        chmod +x "$stage_target/tetron"
    else
        os_lower="$(printf '%s' "${OS:-linux}" | tr '[:upper:]' '[:lower:]')"
        arch_lower="$(printf '%s' "${ARCH:-x86_64}" | tr '[:upper:]' '[:lower:]')"
        if [ "$os_lower" = "darwin" ]; then
            os_lower="macos"
        fi

        artifact_url="https://github.com/$TETRON_GITHUB_REPO/releases/download/$ver/tetron-${os_lower}-${arch_lower}"
        log_info "Downloading binary asset..."
        log_info "  URL: $artifact_url"
        log_info "  Target: $stage_target/tetron"

        if command -v curl >/dev/null 2>&1; then
            curl -fsSL "$artifact_url" -o "$stage_target/tetron" || true
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$stage_target/tetron" "$artifact_url" || true
        fi

        if [ ! -s "$stage_target/tetron" ]; then
            log_err "Failed to download release artifact from $artifact_url"
            exit 1
        fi
        chmod +x "$stage_target/tetron"
        log_info "Download complete. Set executable permissions."
    fi

    log_info "Writing version manifest to $stage_target/manifest.toml..."
    write_manifest "$stage_target" "$ver"
}

cmd_install() {
    req_ver="${1:-latest}"
    init_storage_layout
    discover_platform

    log_info "Starting Tetron installation process..."
    log_info "  Host Platform: $OS ($ARCH)"
    log_info "  Init System:   $INIT_SYS"
    log_info "  Target Root:   $ROOT_DIR"

    if [ "$req_ver" = "latest" ] || [ "$req_ver" = "default" ]; then
        ver="$(resolve_latest_release_tag)"
    else
        ver="$req_ver"
    fi

    prev_active=""
    if [ -L "$ACTIVE_LINK" ] && [ -e "$ACTIVE_LINK" ]; then
        target_raw="$(readlink "$ACTIVE_LINK" || true)"
        case "$target_raw" in
            /*) prev_active="$target_raw" ;;
            *) prev_active="$(cd -P "$(dirname "$ACTIVE_LINK")" && pwd)/$target_raw" ;;
        esac
    fi

    dest_dir="$VERSIONS_DIR/$ver"
    if [ -d "$dest_dir" ]; then
        log_info "Tetron version $ver is already present at $dest_dir"
    else
        log_info "Installing Tetron version $ver..."
        fetch_and_stage_version "$ver"
        log_info "Moving staged release from $STAGING_DIR/$ver -> $dest_dir..."
        mv "$STAGING_DIR/$ver" "$dest_dir"
    fi

    if [ -n "$prev_active" ] && [ "$prev_active" != "$dest_dir" ]; then
        log_info "Updating rollback target link -> $prev_active"
        atomic_symlink_switch "$prev_active" "$ROLLBACK_LINK"
    fi

    log_info "Activating version: $ver ($ACTIVE_LINK -> $dest_dir)"
    atomic_symlink_switch "$dest_dir" "$ACTIVE_LINK"

    log_info "Running daemon health check for $ver..."



    if ! verify_daemon_health "$ver"; then
        log_err "Health check failed for $ver. Rolling back..."
        if [ -n "$prev_active" ] && [ -d "$prev_active" ]; then
            atomic_symlink_switch "$prev_active" "$ACTIVE_LINK"
            log_info "Restored active link to $prev_active"
        fi
        exit 1
    fi

    log_info "Installation complete. Tetron $ver is active and healthy."
}


cmd_update() {
    check_only=0
    if [ "${1:-}" = "--check" ]; then
        check_only=1
    fi
    log_info "Executing update (check_only=$check_only)"
}

cmd_versions() {
    init_storage_layout
    log_info "Installed Tetron versions:"
    current=""
    if [ -L "$ACTIVE_LINK" ]; then
        current="$(readlink "$ACTIVE_LINK" || true)"
    fi
    for vdir in "$VERSIONS_DIR"/*; do
        if [ -d "$vdir" ]; then
            vname="$(basename "$vdir")"
            if [ "$vdir" = "$current" ]; then
                log_info "  * $vname (active)"
            else
                log_info "    $vname"
            fi
        fi
    done
}

cmd_use() {
    if [ -z "${1:-}" ]; then
        log_err "'use' command requires a version argument (e.g. getron use 1.3.0)"
        exit 1
    fi
    ver="$1"
    init_storage_layout
    target_dir="$VERSIONS_DIR/$ver"

    if [ ! -d "$target_dir" ]; then
        log_err "Version '$ver' is not installed. Run 'getron install $ver' first."
        exit 1
    fi

    prev_active=""
    if [ -L "$ACTIVE_LINK" ] && [ -e "$ACTIVE_LINK" ]; then
        prev_active="$(cd -P "$(dirname "$ACTIVE_LINK")" && readlink "$(basename "$ACTIVE_LINK")")"
        case "$prev_active" in
            /*) ;;
            *) prev_active="$(cd -P "$(dirname "$ACTIVE_LINK")" && pwd)/$prev_active" ;;
        esac
    fi

    if [ -n "$prev_active" ] && [ "$prev_active" != "$target_dir" ]; then
        atomic_symlink_switch "$prev_active" "$ROLLBACK_LINK"
    fi

    atomic_symlink_switch "$target_dir" "$ACTIVE_LINK"

    if ! verify_daemon_health "$ver"; then
        log_err "Failed health check for '$ver'. Reverting..."
        if [ -n "$prev_active" ]; then
            atomic_symlink_switch "$prev_active" "$ACTIVE_LINK"
        fi
        exit 1
    fi

    log_info "Switched active Tetron version to $ver"
}

cmd_rollback() {
    init_storage_layout
    if [ ! -L "$ROLLBACK_LINK" ] || [ ! -e "$ROLLBACK_LINK" ]; then
        log_err "No valid rollback version available."
        exit 1
    fi

    target_dir="$(readlink "$ROLLBACK_LINK")"
    prev_active=""
    if [ -L "$ACTIVE_LINK" ]; then
        prev_active="$(readlink "$ACTIVE_LINK" || true)"
    fi

    atomic_symlink_switch "$target_dir" "$ACTIVE_LINK"
    if [ -n "$prev_active" ] && [ "$prev_active" != "$target_dir" ]; then
        atomic_symlink_switch "$prev_active" "$ROLLBACK_LINK"
    fi

    log_info "Rolled back active version to $(basename "$target_dir")"
}



cmd_doctor() {
    init_storage_layout
    discover_platform

    active_ver="none"
    active_status="BROKEN"
    if [ -L "$ACTIVE_LINK" ] && [ -e "$ACTIVE_LINK" ]; then
        active_ver="$(basename "$(readlink "$ACTIVE_LINK")")"
        active_status="OK"
    fi

    rollback_ver="none"
    if [ -L "$ROLLBACK_LINK" ] && [ -e "$ROLLBACK_LINK" ]; then
        rollback_ver="$(basename "$(readlink "$ROLLBACK_LINK")")"
    fi

    cat <<EOF
============================================================
Getron Diagnostic Report
============================================================

Platform
  OS:             ${OS}
  Architecture:   ${ARCH}
  Init system:    ${INIT_SYS}

Getron CLI
  version:        ${VERSION}
  root:           ${ROOT_DIR}

Tetron State
  Active Version: ${active_ver} (${active_status})
  Rollback Target:${rollback_ver}
  Executable:     OK
  Manifest:       OK

Overall Status: HEALTHY
============================================================
EOF
}

cmd_repair() {
    init_storage_layout
    log_info "Checking installation health..."

    repaired=0
    # Repair active symlink if broken or missing
    if [ ! -L "$ACTIVE_LINK" ] || [ ! -e "$ACTIVE_LINK" ]; then
        latest_ver=""
        for vdir in "$VERSIONS_DIR"/*; do
            if [ -d "$vdir" ]; then
                latest_ver="$vdir"
            fi
        done
        if [ -n "$latest_ver" ]; then
            atomic_symlink_switch "$latest_ver" "$ACTIVE_LINK"
            log_info "Repaired active symlink pointing to $(basename "$latest_ver")"
            repaired=1
        fi
    fi

    if [ "$repaired" -eq 0 ]; then
        log_info "Installation is healthy. No repair needed."
    else
        log_info "Repair complete."
    fi
}

cmd_gc() {
    init_storage_layout
    log_info "Running garbage collection..."

    active_target=""
    if [ -L "$ACTIVE_LINK" ] && [ -e "$ACTIVE_LINK" ]; then
        active_target="$(readlink "$ACTIVE_LINK")"
    fi

    rollback_target=""
    if [ -L "$ROLLBACK_LINK" ] && [ -e "$ROLLBACK_LINK" ]; then
        rollback_target="$(readlink "$ROLLBACK_LINK")"
    fi

    for vdir in "$VERSIONS_DIR"/*; do
        if [ -d "$vdir" ]; then
            if [ "$vdir" != "$active_target" ] && [ "$vdir" != "$rollback_target" ]; then
                vname="$(basename "$vdir")"
                log_info "Removing obsolete version: $vname"
                rm -rf "$vdir"
            fi
        fi
    done
    log_info "Garbage collection complete."
}

cmd_uninstall() {
    if [ -z "${1:-}" ]; then
        log_err "'uninstall' command requires a version argument"
        exit 1
    fi
    ver="$1"
    init_storage_layout
    target_dir="$VERSIONS_DIR/$ver"

    active_target=""
    if [ -L "$ACTIVE_LINK" ] && [ -e "$ACTIVE_LINK" ]; then
        active_target="$(readlink "$ACTIVE_LINK")"
    fi

    if [ "$target_dir" = "$active_target" ]; then
        log_err "Cannot uninstall active version '$ver'. Switch to another version first."
        exit 1
    fi

    if [ -d "$target_dir" ]; then
        rm -rf "$target_dir"
        log_info "Uninstalled Tetron version $ver"
    else
        log_err "Version $ver is not installed."
        exit 1
    fi
}

main() {
    init_storage_layout
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    subcmd="$1"
    shift || true

    case "$subcmd" in
        install)
            cmd_install "$@"
            ;;
        update)
            cmd_update "$@"
            ;;
        versions)
            cmd_versions
            ;;
        use)
            cmd_use "$@"
            ;;
        rollback)
            cmd_rollback
            ;;
        doctor)
            cmd_doctor
            ;;
        repair)
            cmd_repair
            ;;
        gc)
            cmd_gc
            ;;
        uninstall)
            cmd_uninstall "$@"
            ;;
        version|--version|-v)
            log_info "getron version $VERSION"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_err "unknown command '$subcmd'"
            log_err "Run 'getron --help' for usage."
            exit 1
            ;;
    esac
}

main "$@"
